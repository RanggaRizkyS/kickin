{
  "name": "football-club-discord-bot",
  "version": "2.5.0",
  "private": true,
  "description": "Discord football club game with consistent English copy, fixed-width embed tables, player collection, squad management, and 90-minute match simulation",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "check": "node scripts/check.js",
    "test": "node --test scripts/*.test.js",
    "hash-admin-password": "node scripts/hash-admin-password.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.2.0",
    "bcryptjs": "2.4.3",
    "discord.js": "14.21.0",
    "dotenv": "16.4.7",
    "mariadb": "3.4.0"
  }
}
